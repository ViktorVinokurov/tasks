POSTGRES_USER=diary
POSTGRES_PASSWORD=change-me
POSTGRES_DB=diary
CORS_ORIGINS=http://localhost:3000
# Длинная случайная строка. Ею подписываются сессии. На сервере задайте свою.
JWT_SECRET=change-me-to-a-long-random-string
# Ключи Web Push. Сгенерируйте в каталоге backend: python -m app.vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:diary@localhost
# Только docker-compose.prod.yml. 3000 публикует интерфейс, 127.0.0.1:3000 оставляет его на сервере.
WEB_BIND=3000
